CI_NAME=build_O2_alidist-ubuntu2204
PACKAGE=O2Suite
ALIBUILD_DEFAULTS=o2
PR_REPO=alisw/alidist
PR_BRANCH=master
BRANCH_REMOTE_STORE=s3://alibuild-repo::rw
NO_ASSUME_CONSISTENT_EXTERNALS=
TRUST_COLLABORATORS=true
CHECK_NAME=build/O2/alidist-ubuntu2204
DONT_USE_COMMENTS=1
DEVEL_PKGS="$PR_REPO $PR_BRANCH
AliceO2Group/AliceO2 dev O2"
# O2 tests off until CCDB grants this builder's DN delete rights on Test/*.
# ccdb-test answers 403 to truncate/delete, so delete_test fails and list_test
# miscounts as each run's leftovers accumulate. Writes work; only removal is
# denied. slc9 keeps them on -- see mesosci/slc9/o2-alidist.env.
ALIBUILD_O2_TESTS=
ALIBUILD_XJALIENFS_TESTS=1
