CI_NAME=build_O2_alidist-ubuntu2204
PACKAGE=O2Suite
ALIBUILD_DEFAULTS=o2
PR_REPO=alisw/alidist
PR_BRANCH=master
BRANCH_REMOTE_STORE=s3://alibuild-repo::rw
NO_ASSUME_CONSISTENT_EXTERNALS=
TRUST_COLLABORATORS=true
CHECK_NAME=build/O2/alidist-ubuntu2204
DONT_USE_COMMENTS=1
# TEMPORARY: O2 from AliceO2#15724 rather than dev, to see the CCDB fixes here
# before they merge. Two of this check's four test failures need them:
# testCcdbApi.cxx:461 (the etag kept its CRLF, which ate the gate token appended
# after it) and testTPCCalDet.cxx (hardcoded production CCDB, unreachable from
# the build container; the PR makes it honour ALICEO2_CCDB_PRODUCTION_HOST,
# which round-setup now sets).
#
# Revert to "dev" once it merges -- a pinned PR silently stops tracking dev, so
# this check would go on testing a stale merge base indefinitely.
#
# Note the check stays RED regardless: testCcdbApiHeaders fails for a reason
# nobody has diagnosed yet. Read the failure COUNT and names, not the colour.
DEVEL_PKGS="$PR_REPO $PR_BRANCH
AliceO2Group/AliceO2 pull/15724/head O2"
ALIBUILD_O2_TESTS=1
ALIBUILD_XJALIENFS_TESTS=1
