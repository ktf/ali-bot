CI_NAME=build_O2_alidist-ubuntu2204
PACKAGE=O2Suite
ALIBUILD_DEFAULTS=o2
PR_REPO=alisw/alidist
PR_BRANCH=master
BRANCH_REMOTE_STORE=s3://alibuild-repo::rw
NO_ASSUME_CONSISTENT_EXTERNALS=
TRUST_COLLABORATORS=true
CHECK_NAME=build/O2/alidist-ubuntu2204
DONT_USE_COMMENTS=1
# O2 tests all pass here since AliceO2#15724 merged into dev (a63c2a255530).
#
# TEMPORARY: QualityControl from QualityControl#2685 rather than the v1.195.1
# tag alidist pins, which is the last thing keeping this check red. testTriggers
# and testReductor talk to CCDB but lack the CCDB ctest label the recipe filters
# on, so those two alone escape the exclusion and then cannot reach ccdb-test
# from in here. The PR makes them honour ALICEO2_CCDB_HOST, which round-setup
# already sets, so they go through the broker like every other CCDB test.
#
# Drop this line once the PR merges AND alidist bumps qualitycontrol.sh -- a
# pinned PR silently stops tracking the release, so this check would otherwise
# go on testing a stale QualityControl indefinitely.
DEVEL_PKGS="$PR_REPO $PR_BRANCH
AliceO2Group/AliceO2 dev O2
AliceO2Group/QualityControl pull/2685/head"
ALIBUILD_O2_TESTS=1
ALIBUILD_XJALIENFS_TESTS=1
