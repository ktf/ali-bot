# A deliberately tiny release, for proving the path end to end before a real one
# does it for five hours: tag -> claim -> checkout -> build -> reapi upload.
#
# zlib is a good probe precisely because of --no-system in DEFAULTS.env. Left to
# itself its prefer_system check succeeds on slc10 and nothing would be built at
# all; with --no-system it really compiles, and its only dependencies
# (GCC-Toolchain, alibuild-recipe-tools) are already in the CAS from the slc10
# PR builds, so they download rather than build. The result exercises a CAS READ
# and a CAS WRITE in a couple of minutes.
#
# Cut the tag by hand on alidist, e.g.
#   git tag zlib-test-20260825 && git push origin zlib-test-20260825
# Any commit will do -- the build checks out the tag, and zlib's own recipe pins
# its source with `tag: v1.3.1`.
CI_NAME=build_zlib_test_slc10
PACKAGE=zlib
PR_REPO=alisw/alidist
PR_BRANCH=master
# Same defaults as the slc10 PR checks, so the dependency tarballs already in
# alibuild-cas are hits rather than rebuilds.
ALIBUILD_DEFAULTS=o2
TAG_REGEX='^zlib-test-%(date)(?P<variant>-[0-9]{4})?$'
CHECK_NAME=release/zlib/test-slc10-x86
DONT_USE_COMMENTS=1
