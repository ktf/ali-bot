# Release builder for ubuntu2204, alongside slc10-release on the same worker.
#
# WHY. Nothing publishes ubuntu2204 packages, so every ubuntu PR round rebuilds
# the whole stack from source -- which is why a cold builder spends its first
# hours on GCC-Toolchain and Clang. With the store populated, a round fetches the
# stack and compiles only what the PR changes, so its cost tracks the diff rather
# than the stack.
#
# SAME JOB, not a second one: after the first iteration almost nothing is
# rebuilt, so serialising ubuntu behind slc10 on one worker costs little. If the
# two ever do contend, ci-linux-x86-release goes to count = 2 rather than
# splitting into separate jobs.
#
# The container directory is $CUR_CONTAINER$ALIBOT_CONFIG_SUFFIX, and the job
# sets ALIBOT_CONFIG_SUFFIX="-release" -- so adding "ubuntu2204" to
# CUR_CONTAINERS is what makes this directory be read at all.
ARCHITECTURE=ubuntu2204_x86-64
CONTAINER_IMAGE=registry.cern.ch/alisw/ubuntu2204-builder:latest

# aliBuild 2.0: the only one that speaks reapi:// and can write the CAS.
INSTALL_ALIBUILD='alisw/alibuild@refs/pull/1038/head'

# Identical store wiring to slc10-release, deliberately: blobs content-addressed
# in alibuild-cas, the legacy TARS/ tree published to alibuild-repo with absolute
# redirects, and the Action Cache signed. See slc10-release/DEFAULTS.env for why
# each flag is spelled the way it is -- in particular that --legacy-links-store
# must name the SAME host as --remote-store and must NOT carry ::rw.
REMOTE_STORE="reapi://${ALIBOT_PROXY_HOSTPORT}/alibuild-cas::rw"
BRANCH_REMOTE_STORE="reapi://${ALIBOT_PROXY_HOSTPORT}/alibuild-cas::rw"
ALIBUILD_EXTRA_ARGS="--ac-store reapi://${ALIBOT_PROXY_HOSTPORT}/alibuild-ac::rw --no-system --insecure --sign-url ${ALIBOT_SIGN_URL} --sign-token-file ${ALIBOT_SIGN_TOKEN_FILE} --legacy-links-store reapi://${ALIBOT_PROXY_HOSTPORT}/alibuild-repo --cas-public-url https://s3.cern.ch/swift/v1/alibuild-cas"

# --storage is left at its default, 'ephemeral', as for slc10-release: these are
# CI packages, continuously rebuilt, so the LRU of the bucket keeps what is still
# in use and expires what is not.

# 14, matching slc10-release: this is the SAME allocation, which was not part of
# the 2026-08-31 resize of the PR builders. Do not copy 24 from
# ubuntu2204/DEFAULTS.env -- that number belongs to a 24-core allocation.
JOBS=14
