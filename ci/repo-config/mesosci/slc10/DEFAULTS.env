# Per container, because one worker serves several (CUR_CONTAINERS in
# ci-linux-x86.nomad). Plain assignments, so they win over whatever the job
# exported for the container it happened to start with.
ARCHITECTURE=slc10_x86-64
CONTAINER_IMAGE=registry.cern.ch/alisw/slc10-builder:latest

# mesosci/DEFAULTS.env sets JOBS=24 for the shared pool, and source_env_files
# runs before build-loop.sh reads it -- so that value silently overrides the
# JOBS the job exports, and the 54 GiB budget in ci-linux-x86.nomad was being
# spent 24 ways rather than 14. Now that build-loop.sh caps the container at
# that budget, an overrun is an OOM-killed build rather than a node-wide
# reclaim storm, so the split has to be one the budget can actually cover:
# measured peak RSS for the heaviest O2Physics TUs runs 3-6 GiB each.
#
# 14 was the first attempt and it did NOT fit: with the cap live, builds died on
# "c++: fatal error: Killed signal terminated program cc1plus". That matches the
# measurement -- the 14 heaviest model at ~52 GiB against a ~51 GiB cap, i.e. no
# headroom at all, and the model under-predicts the tail.
#
# 10 was the safe retreat while nothing bounded the heavy TUs. Now something
# does: O2Physics#17649 makes ANALYSIS_COMPILE_POOL read the cgroup limit --
# merged 2026-08-28 and carried by the daily-20260829-0000 tag alidist pins, so
# it arrives with the tag and no longer needs a DEVEL_PKGS pin to be present. So
# the ~2900 analysis workflows -- which is where the 7-10 GiB peaks live -- are
# held to 6 in parallel no matter what JOBS says. JOBS therefore governs the
# REST: all of O2, and the few hundred non-workflow O2Physics targets, none of
# which showed peaks anywhere near those.
#
# Measured on a live round before raising this: 3198 O2Physics targets at a flat
# ~34 targets/min, with no stall over 3.3 min and none at all over 5. A build
# starved by the pool would show repeated multi-minute gaps as six heavy TUs
# filled every slot; it does not. The slowness is width, not the pool -- and 10
# is well under the 24 cores reserved per allocation.
#
# If OOM kills come back, the answer is still to lower this rather than to raise
# the reservation, and to check the pool actually bound (look for "Limiting
# workflow compilations in parallel to:" in the O2Physics configure output).
JOBS=14
