CI_NAME=build_O2_alidist_dataflow_slc10_x86
PACKAGE=O2Suite
ALIBUILD_DEFAULTS=o2-dataflow
PR_REPO=alisw/alidist
PR_BRANCH=master
NO_ASSUME_CONSISTENT_EXTERNALS=
TRUST_COLLABORATORS=true
CHECK_NAME=build/O2/alidist-dataflow-slc10-x86
DONT_USE_COMMENTS=1
DEVEL_PKGS="$PR_REPO $PR_BRANCH"
ALIBUILD_O2_TESTS=1
ALIBUILD_O2PHYSICS_TESTS=1

# As in o2-alidist.env: slc10 tarballs are only in the CAS store, and only
# aliBuild 2.0 can read it or accept an slc10 architecture.
REMOTE_STORE=https://s3.cern.ch/swift/v1/alibuild-cas
INSTALL_ALIBUILD='alisw/alibuild@refs/pull/1038/head'

# No ONLY_PRS: alidist#6193 merged on 2026-08-25, and a pin to a merged PR is
# not a narrowed check, it is a dead one -- the allowlist matches nothing the
# lister ever offers, so this check silently stopped building anything at all.
#
# What it was for is now on master anyway: 6193 carried mesos.sh, and this is
# still the check that exercises it, because o2-dataflow (unlike the o2
# defaults) does not disable mesos and o2suite.sh requires it on slc.*x86.
