CI_NAME=build_O2_alidist_dataflow_slc10_x86
PACKAGE=O2Suite
ALIBUILD_DEFAULTS=o2-dataflow
PR_REPO=alisw/alidist
PR_BRANCH=master
NO_ASSUME_CONSISTENT_EXTERNALS=
TRUST_COLLABORATORS=true
CHECK_NAME=build/O2/alidist-dataflow-slc10-x86
DONT_USE_COMMENTS=1
DEVEL_PKGS="$PR_REPO $PR_BRANCH"
ALIBUILD_O2_TESTS=1
ALIBUILD_O2PHYSICS_TESTS=1

# As in o2-alidist.env: slc10 tarballs are only in the CAS store, and only
# aliBuild 2.0 can read it or accept an slc10 architecture.
REMOTE_STORE=https://s3.cern.ch/swift/v1/alibuild-cas
INSTALL_ALIBUILD='alisw/alibuild@refs/pull/1038/head'

# BRING-UP: 6313 only, while the gettext fix is validated.
#
# The previous pin was 6193, which merged on 2026-08-25 -- a pin to a merged PR
# is not a narrowed check but a dead one, since the allowlist then matches
# nothing the lister ever offers and the check silently builds nothing at all.
# Removing it is what let this check run again and surface the failure below.
#
# 6313 fixes autotools: gettext regenerates plural.c with bison -d (hardcoded as
# YACC in gettext-runtime/intl/Makefile.am), which emits #include "plural.h",
# and the same rule then deletes plural.h -- so the build dies on
# "plural.c:133:10: fatal error: plural.h: No such file or directory".
#
# This is the check that hits it, and the only one that does: autotools reaches
# slc10 solely via mesos.sh, whose build_requires says "autotools:(slc.*)" where
# every other recipe says "(slc6|slc7)". o2-dataflow is in turn the only
# defaults that leaves mesos enabled. Drop this pin once 6313 merges.
ONLY_PRS=6313

# JOBS=10, overriding the 14 in DEFAULTS.env, until a daily tag carries the pool
# fix.
#
# 14 is safe on the other slc10 checks because they build PACKAGE=O2, which has
# none of the 7-10 GiB analysis translation units. This one is PACKAGE=O2Suite
# with ALIBUILD_O2PHYSICS_TESTS=1, so it does build them -- and it takes
# O2Physics from the tag alidist pins, not from a PR. That tag is
# daily-20260828-0000, cut at midnight; O2Physics#17649, which makes
# ANALYSIS_COMPILE_POOL read the cgroup limit instead of host memory, merged at
# 14:50 the same day. So the pool here still sizes itself from 251 GiB, computes
# ~124, and never binds -- exactly the state in which 14 killed cc1plus.
#
# ubuntu2204/o2-alidist.env avoids this by pinning O2Physics to the PR. Not done
# here on purpose: this check exists to validate alidist#6313 against the
# content a release would see, and injecting a PR branch would weaken that.
#
# Drop this override once o2physics.sh pins a tag at or after that merge.
JOBS=10
